# ============================================================
# .env.example — Template for environment variables
# ============================================================
# HOW TO USE:
#   1. Copy this file: copy .env.example .env
#   2. Fill in YOUR actual values in .env
#   3. NEVER commit .env to Git (it's in .gitignore)
#
# WHY THIS APPROACH?
#   Hard-coding secrets in code = security incident.
#   .env files = secrets stay on your machine only.
#   .env.example = team knows what variables are needed.
# ============================================================

# ----- Application -----
APP_ENV=development          # development | staging | production
APP_NAME=insurance-claims-platform
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_SECRET_KEY=your-secret-key-here-min-32-chars  # Used for JWT signing

# ----- Mock External API -----
MOCK_API_BASE_URL=http://localhost:8001
MOCK_API_KEY=mock-api-key-change-in-prod
MOCK_API_PAGE_SIZE=100

# ----- MySQL Database -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=insurance_claims_db
MYSQL_USER=claims_user
MYSQL_PASSWORD=your-strong-password-here
MYSQL_ROOT_PASSWORD=your-root-password-here    # Only needed for Docker

# ----- AWS -----
AWS_REGION=us-east-1          # us-east-1 is free-tier region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=insurance-claims-landing-yourname   # Must be globally unique
S3_MODEL_ARTIFACTS_PREFIX=model-artifacts/
LAMBDA_FUNCTION_NAME=claims-etl-trigger

# ----- Machine Learning -----
ML_MODELS_DIR=ml/artifacts    # Local path for model files
ML_CONTAMINATION=0.05         # Isolation Forest: expected fraud rate (~5%)

# ----- LLM / RAG -----
GEMINI_API_KEY=your-gemini-api-key-here    # From Google AI Studio (free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
EMBEDDING_MODEL=all-MiniLM-L6-v2          # sentence-transformers model (downloads automatically)

# ----- Redis Cache -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true
FAISS_INDEX_PATH=rag_chatbot/faiss_index

# ----- Rate Limiting (Mock API simulation) -----
MOCK_API_RATE_LIMIT_PER_MINUTE=60
MOCK_API_FAILURE_RATE=0.05    # 5% chance of simulated failure (realistic!)

# ----- ETL -----
ETL_BATCH_SIZE=500            # Records per batch load
ETL_CHECKPOINT_TABLE=etl_checkpoints   # Tracks last successful run (for incremental loads)
